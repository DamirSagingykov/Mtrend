# ─────────────────────────────────────────────────────────────
# M-TREND — переменные окружения
# Скопируйте в .env и заполните. НИКОГДА не коммитьте .env в git.
# ─────────────────────────────────────────────────────────────

# База данных PostgreSQL (обязательно)
DATABASE_URL="postgresql://mtrend:STRONG_PASSWORD@localhost:5432/mtrend?schema=public"

# Публичный адрес сайта (без / в конце). Используется в canonical, sitemap, ссылках в письмах
APP_URL="https://mtrend.kz"

# Секрет для хэширования сессий: длинная случайная строка (openssl rand -hex 32)
SESSION_SECRET=""

# Разрешить индексацию поисковиками (true только на боевом домене)
ROBOTS_ALLOW_INDEX="false"

# Первый администратор (используется при npm run db:seed)
ADMIN_EMAIL="admin@mtrend.kz"
ADMIN_PASSWORD=""
# Создавать демо-товары при seed (false — для боевой базы)
SEED_DEMO="true"

# ─── Хранилище фотографий ───
# local — файлы на диске сервера (UPLOAD_DIR), s3 — S3-совместимое облако
STORAGE_DRIVER="local"
UPLOAD_DIR="./storage/uploads"
# Для STORAGE_DRIVER=s3 (AWS S3, Yandex Object Storage, Cloudflare R2, PS Cloud и т.п.)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Публичный URL бакета или CDN, например https://cdn.mtrend.kz
S3_PUBLIC_URL=""

# ─── Интеграция с 1С ───
# Токен API (не короче 24 символов). Пусто — интеграция отключена
ONEC_API_TOKEN=""
# Секрет HMAC-подписи запросов (рекомендуется)
ONEC_HMAC_SECRET=""
# Разрешённые IP сервера 1С через запятую (необязательно)
ONEC_ALLOWED_IPS=""

# ─── Email (SMTP) — уведомления покупателю и администраторам ───
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="M-TREND <no-reply@mtrend.kz>"

# ─── Telegram-бот для уведомлений менеджеров о новых заказах ───
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ─── WhatsApp Business Cloud API (Meta) — только официальная интеграция ───
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Имя одобренного шаблона сообщения о новом заказе (параметры: номер заказа, сумма)
WHATSAPP_TEMPLATE_NEW_ORDER=""

# ─── Kaspi Pay (после заключения договора и получения API) ───
KASPI_MERCHANT_ID=""
KASPI_API_KEY=""

# Сборка standalone для Docker
# NEXT_OUTPUT="standalone"
